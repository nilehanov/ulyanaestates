# Copy to .env.local for local dev, and set as GitHub Actions secret WEB3FORMS_KEY for prod.
# This is a PUBLIC Web3Forms access key (safe in the client bundle) — but keep it out of git.
# Get one free at https://web3forms.com (sends submissions to ulyanaestates@gmail.com).
# If unset, the contact form gracefully falls back to a mailto: link.
NEXT_PUBLIC_WEB3FORMS_KEY=
